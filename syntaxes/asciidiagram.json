{
  "scopeName": "source.asciidiagram",
  "patterns": [
    {
      "begin": "^([ \\t]*)(│)(?=[^\\r\\n]*│[ \\t]*$)",
      "beginCaptures": {
        "2": {
          "name": "punctuation.border.asciidiagram"
        }
      },
      "end": "$",
      "contentName": "string.inside.asciidiagram",
      "patterns": [
        {
          "include": "#lines"
        },
        {
          "include": "#connections"
        }
      ]
    },
    {
      "include": "#lines"
    },
    {
      "include": "#connections"
    },
    {
      "match": "\\S",
      "name": "string.outside.asciidiagram"
    }
  ],
  "repository": {
    "lines": {
      "patterns": [
        {
          "match": "[\\u2500-\\u257f]+",
          "name": "punctuation.border.asciidiagram"
        }
      ]
    },
    "connections": {
      "patterns": [
        {
          "match": "<[-]+>|<[-]+|[-]+>|[|^]|(?<!\\S)v(?!\\S)|\\+[-+]+|[←↑→↓↔↕]+",
          "name": "keyword.connection.asciidiagram"
        }
      ]
    }
  }
}
